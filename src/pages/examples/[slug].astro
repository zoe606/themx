---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EXAMPLES, resolveExample } from "../../lib/exampleCatalog";
import { generatePrompt } from "../../lib/generatePrompt";
import { UI_LIBRARIES } from "../../lib/promptOptions";
import { getCollection } from "astro:content";
import results from "../../data/example-results.json";
import manifest from "../../generated/example-manifest.json";

export function getStaticPaths() { return EXAMPLES.map((spec) => ({ params: { slug: spec.slug }, props: { spec } })); }
const { spec } = Astro.props;
const themes = (await getCollection("themes")).map((item) => item.data);
const example = resolveExample(spec, themes);
const result = (results as Record<string, { capturedAt: string; artifactHash: string; browser: string; checks: string[]; axeViolations: number; viewports: { width: number; height: number }[]; review: string[] }>)[spec.slug];
const current = result && result.artifactHash === manifest[spec.slug as keyof typeof manifest].artifactHash;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title={example.title} description={`${example.summary} Includes the recorded themx prompt, source, screenshots, and browser check results.`}>
  <main class="mx-auto max-w-6xl px-6 py-10" data-example-status={current ? "verified" : "needs-review"}>
    <a class="text-sm underline" href={`${base}/examples/`}>← All examples</a><p class="mt-5 text-sm" style="color: var(--tx-text-muted);">{example.theme.name} · {UI_LIBRARIES[example.setup.uiLibrary].label} · {example.setup.framework}</p>
    <h1 class="mt-3 text-3xl font-semibold" style="font-family: var(--tx-font-heading);">{example.title}</h1><p class="mt-3" style="color: var(--tx-text-muted);">{example.summary}</p>
    <div class="mt-6 flex flex-wrap gap-3"><a class="tx-button" href={`${base}/demos/${example.slug}/`} target="_blank" rel="noreferrer">Open runnable demo ↗</a><a class="tx-button" href={`${base}/demos/${example.slug}/${example.slug}.zip`} download>Download example .zip</a><a class="tx-button" href={`${base}/demos/${example.slug}/setup.json`} download>Download setup</a><a class="tx-button" href={`${base}/themes/${example.theme.slug}/#prompt-builder`}>Open theme builder</a></div>
    <section class="glass mt-8 p-6"><h2 class="text-xl font-semibold">Live example</h2><p class="my-3 text-sm" style="color: var(--tx-text-muted);">Try the sample interactions. Open the standalone demo for a full-width view. No data is sent to a server.</p><div class="preview-frame"><iframe title={`${example.title} runnable example`} src={`${base}/demos/${example.slug}/`} sandbox="allow-scripts allow-forms" class="w-full border-0" height="950" loading="lazy"></iframe></div></section>
    <section class="mt-9"><h2 class="text-xl font-semibold">Captured screenshots</h2><div class="mt-5 grid items-start gap-6 md:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]"><figure class="glass overflow-hidden"><img src={`${base}/examples/${example.slug}-desktop.png`} alt={`${example.title} desktop screenshot`} width="1440" loading="lazy" /><figcaption class="p-3 text-sm">Desktop · 1440px</figcaption></figure><figure class="glass overflow-hidden"><img src={`${base}/examples/${example.slug}-mobile.png`} alt={`${example.title} mobile screenshot`} width="390" loading="lazy" /><figcaption class="p-3 text-sm">Mobile · 390px</figcaption></figure></div></section>
    <section class="glass mt-9 p-6"><h2 class="text-xl font-semibold">Verification results</h2>{current ? <><p class="mt-3 text-sm">Captured {result.capturedAt} in {result.browser}. The checks below match the current example assets.</p><ul class="mt-4 list-inside list-disc space-y-2">{result.checks.map((check) => <li>{check}</li>)}</ul><p class="mt-4 text-sm">Automated accessibility violations: {result.axeViolations}. These checks cover the tested pages and states. They do not establish complete accessibility compliance.</p><ul class="mt-4 list-inside list-disc space-y-2">{result.review.map((note) => <li>{note}</li>)}</ul></> : <p class="mt-3">This version needs new screenshots and browser verification. Earlier results do not match its current assets.</p>}</section>
    <section class="glass mt-9 p-6"><h2 class="text-xl font-semibold">Recorded prompt and source</h2><p class="mt-3" style="color: var(--tx-text-muted);">This implementation was produced by the coding agent from the saved themx setup, then corrected during browser verification. The ZIP contains runnable HTML, assets, source templates, tokens, documents, and the saved prompt. Source templates are built in the themx repository.</p><div class="my-4 flex flex-wrap gap-4"><a class="underline" href={`${base}/demos/${example.slug}/ui-prompt.txt`}>Prompt text</a><a class="underline" href={`${base}/demos/${example.slug}/DESIGN.md`}>DESIGN.md</a><a class="underline" href={`${base}/demos/${example.slug}/source/${spec.preset}.tsx`}>Source template</a></div><pre class="tx-code"><code>{generatePrompt(example.config)}</code></pre></section>
  </main>
</BaseLayout>
