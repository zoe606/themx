---
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${base}`, label: "Themes" },
  { href: `${base.replace(/\/$/, "")}/compare`, label: "Compare" },
  { href: `${base.replace(/\/$/, "")}/examples`, label: "Examples" },
  { href: `${base.replace(/\/$/, "")}/about`, label: "About" },
];
---
<header class="glass sticky top-0 z-50 rounded-none border-x-0 border-t-0 border-b border-white/10">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-4">
    <a href={base} class="text-xl font-bold tracking-tight" style="font-family: var(--tx-font-heading); color: var(--tx-text);">
      themx
    </a>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 sm:gap-x-6" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium transition-colors hover:opacity-100"
          style="color: var(--tx-text-muted);"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
